    "The clip could not be removed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移除片段。"
          }
        }
      }
    },
    "The coach answers on your move.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你走棋时，教练才会回答。"
          }
        }
      }
    },
    "The coach cannot think at the %@ level, so it stays at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The coach cannot think at the %1$@ level, so it stays at %2$@."
          }
        },
        "zh-Hans": {
