    "%@ on %@ can capture %@ back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@ can capture %3$@ back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
