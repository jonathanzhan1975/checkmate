          "stringUnit": {
            "state": "translated",
            "value": "受到 %1$lld 枚棋子攻击，由 %2$lld 枚棋子保护"
          }
        }
      }
    },
    "attacks %@ %@": {
      "comment": "A square's description: the piece it attacks, then whether that is restricted",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "attacks %1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "攻击 %1$@ %2$@"
          }
        }
      }
    },
    "bishop": {
      "comment": "A piece's bare name, as in the list label: knight e4",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
