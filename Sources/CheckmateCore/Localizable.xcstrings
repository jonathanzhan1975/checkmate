          }
        }
      }
    },
    "Choose a game or position to explore.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要探索的对局或局面。"
          }
        }
      }
    },
    "Choose a language, then translate explicitly. Language selection does not start a request. Speech quality varies by language.": {
      "localizations": {
        "zh-Hans": {
