            "state": "translated",
            "value": "语音教练停止响应。"
          }
        }
      }
    },
    "The voice coach works in Practice and in game reviews.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音教练可在“练习”和对局复盘中使用。"
          }
        }
