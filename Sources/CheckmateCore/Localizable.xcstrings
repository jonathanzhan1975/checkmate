    },
    "The coach cannot think at the %@ level.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练无法使用 %@ 思考级别。"
          }
        }
      }
    },
    "The coach could not complete this response.": {
      "localizations": {
