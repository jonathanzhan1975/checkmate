        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@将%2$@从%3$@走到%4$@。"
          }
        }
      }
    },
    "%@ no longer holds your seat.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已不再为你保留席位。"
          }
        }
      }
    },
    "%@ of yours can move to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of yours can move to %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的%1$@可以走到%2$@。"
          }
        }
      }
    },
    "%@ offered a draw.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@提出了和棋。"
          }
        }
      }
    },
    "%@ offers a draw": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@提出和棋"
          }
        }
      }
    },
    "%@ offers a draw.": {
