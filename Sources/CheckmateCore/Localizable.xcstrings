{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ %@": {
      "comment": "Two whole sentences, one after the other",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@"
          }
        }
      }
    },
    "%@ %@ can move to %@. Type which one, such as %@ or %@.": {
      "comment": "A typed move two or more pieces could make: how many, which kind, the square, then examples to type",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ can move to %3$@. Type which one, such as %4$@ or %5$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@都可以走到%3$@。请输入要走哪一个，例如%4$@或%5$@。"
          }
        }
      }
    },
    "%@ %@ to %@, capturing %@ on %@.": {
      "comment": "A move described: the piece, its squares, what it captured",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ to %3$@, capturing %4$@ on %5$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@走到%3$@，吃掉%4$@（位于%5$@）。"
          }
        }
      }
    },
    "%@ %@ to %@.": {
      "comment": "A move described: the piece and its squares",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ to %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@走到%3$@。"
          }
        }
      }
    },
    "%@ (%@)": {
      "comment": "A toolbar tooltip: the action, then its keyboard shortcut",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (%@): this move gave up about %lld%% of %@'s chances.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@): this move gave up about %3$lld%% of %4$@'s chances."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）：这步棋使%3$lld%%左右的获胜机会从%4$@手中流失。"
          }
        }
      }
    },
    "%@ (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld）"
          }
        }
      }
    },
    "%@ (blunder)": {
      "comment": "A move and its grade, as in: 12. Nf3 (blunder)",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（严重失误）"
          }
        }
      }
    },
    "%@ (mistake)": {
      "comment": "A move and its grade, as in: 12. Nf3 (mistake)",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（失误）"
          }
        }
      }
    },
    "%@ account credit balance: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ account credit balance: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@账户额度余额：%2$@"
          }
        }
      }
    },
    "%@ allows %@ for both players.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ allows %2$@ for both players."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@允许双方使用%2$@。"
          }
        }
      }
    },
    "%@ and %@": {
      "comment": "Two ways of defending a piece, inside a sentence",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@和%2$@"
          }
        }
      }
    },
    "%@ attack %@.": {
      "comment": "Two or more pieces' squares, then the square they attack",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ attack %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@攻击%2$@。"
          }
        }
      }
    },
    "%@ attacks %@.": {
      "comment": "One piece's square, then the square it attacks",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ attacks %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@攻击%2$@。"
          }
        }
      }
    },
    "%@ can block the check on %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ can block the check on %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@可以在%2$@挡住将军。"
          }
        }
      }
    },
    "%@ can no longer be reached within %lld moves.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ can no longer be reached within %lld move."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ can no longer be reached within %lld moves."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@已无法在%lld步内到达。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@已无法在%lld步内到达。"
                }
              }
            }
          }
        }
      }
    },
    "%@ cannot move from %@ to %@ here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ cannot move from %2$@ to %3$@ here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@在此局面下不能从%2$@走到%3$@。"
          }
        }
      }
    },
    "%@ cannot move from %@ to %@.": {
      "comment": "A typed move the piece cannot make",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ cannot move from %2$@ to %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@不能从%2$@走到%3$@。"
          }
        }
      }
    },
    "%@ castled kingside": {
      "comment": "A move announcement: who castled",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@进行了王翼王车易位"
          }
        }
      }
    },
    "%@ castled kingside, check": {
      "comment": "A move announcement: who castled, giving check",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@进行了王翼王车易位，将军"
          }
        }
      }
    },
    "%@ castled kingside, checkmate": {
      "comment": "A move announcement: who castled, giving checkmate",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@进行了王翼王车易位，将死"
          }
        }
      }
    },
    "%@ castled queenside": {
      "comment": "A move announcement: who castled",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@进行了后翼王车易位"
          }
        }
      }
    },
    "%@ castled queenside, check": {
      "comment": "A move announcement: who castled, giving check",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@进行了后翼王车易位，将军"
          }
        }
      }
    },
    "%@ castled queenside, checkmate": {
      "comment": "A move announcement: who castled, giving checkmate",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@进行了后翼王车易位，将死"
          }
        }
      }
    },
    "%@ credit status: unlimited (provider-reported)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@额度状态：无限制（服务提供商报告）"
          }
        }
      }
    },
    "%@ declined the draw": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@拒绝了和棋提议"
          }
        }
      }
    },
    "%@ does not attack %@ on %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ does not attack %2$@ on %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@没有攻击%2$@（位于%3$@）。"
          }
        }
      }
    },
    "%@ doesn't allow spectators.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不允许观战。"
          }
        }
      }
    },
    "%@ has %lld seconds left": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ has %lld second left"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ has %lld seconds left"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@还剩%lld秒"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@还剩%lld秒"
                }
              }
            }
          }
        }
      }
    },
    "%@ has as many spectators as it allows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的观战人数已达上限。"
          }
        }
      }
    },
    "%@ has been away for a while. Claim the win, or keep waiting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已离开一段时间。你可以申领胜利，或继续等待。"
          }
        }
      }
    },
    "%@ has different assistance than the one you accepted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的辅助设置与你之前接受的不同。"
          }
        }
      }
    },
    "%@ has no move.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@没有可走的棋。"
          }
        }
      }
    },
    "%@ has no seat to join.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@没有可加入的席位。"
          }
        }
      }
    },
    "%@ has stopped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已停止。"
          }
        }
      }
    },
    "%@ is a good move here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在这里是一步好棋。"
          }
        }
      }
    },
    "%@ is already over.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已结束。"
          }
        }
      }
    },
    "%@ is away. Their seat is held for 2 minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@暂时离开。其席位将保留2分钟。"
          }
        }
      }
    },
    "%@ is in check and must answer it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正被将军，必须应将。"
          }
        }
      }
    },
    "%@ is in check in this imagined position.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在这个假想局面中正被将军。"
          }
        }
      }
    },
    "%@ is joining…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在加入…"
          }
        }
      }
    },
    "%@ is not a castling attempt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不是王车易位尝试"
          }
        }
      }
    },
    "%@ is not a mixed-practice evaluator": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@不是混合练习评估器"
          }
        }
      }
    },
    "%@ is not better. Try once more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@并没有更好。再试一次。"
          }
        }
      }
    },
    "%@ is not graded as a rule error": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@未被判定为规则错误"
          }
        }
      }
    },
    "%@ is reviewed only once a game is finished, so this one has no review.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@仅在对局结束后才能复盘，因此本局没有复盘。"
          }
        }
      }
    },
    "%@ is the move played in the game. Try another.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@是实战中走的棋。试试其他走法。"
          }
        }
      }
    },
    "%@ is to move in the displayed position.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前显示的局面轮到%@走棋。"
          }
        }
      }
    },
    "%@ is watching.": {
      "comment": "One person watches the network game",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@正在观战。"
          }
        }
      }
    },
    "%@ left the game.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@离开了对局。"
          }
        }
      }
    },
    "%@ moved %@ from %@ to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ moved %2$@ from %3$@ to %4$@."
