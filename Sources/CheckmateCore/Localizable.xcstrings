    },
    "The stored lesson pack is outdated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的课程包已过时。"
          }
        }
      }
    },
    "The stored translation is outdated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的翻译已过时。"
          }
        }
      }
    },
    "The training board changed before your answer reached the learner, so it was not given. Call get_board, then answer the learner's latest turn again from the new board.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的回答送达学习者之前，训练棋盘已改变，因此回答未发送。请调用 get_board，再根据新棋盘重新回答学习者最新一轮的问题。"
          }
        }
      }
    },
    "The training catalog's content version differs from the validated content.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练目录的内容版本与已验证内容不同。"
          }
        }
      }
    },
    "The training search could not load.": {
      "localizations": {
