          }
        }
      }
    },
    "Before %@, the engine's leading option is %@. This short search is provisional; compare its legal replies rather than treating it as a verdict.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Before %1$@, the engine's leading option is %2$@. This short search is provisional; compare its legal replies rather than treating it as a verdict."
