        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还不对。再看看：%@。"
          }
        }
      }
    },
    "Not quite. Take back your move and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还不对。撤回这步，再试一次。"
