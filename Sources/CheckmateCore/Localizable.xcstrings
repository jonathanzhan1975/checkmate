    },
    "The castling square must be c or g on the side to move's back rank.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "王车易位的目标格必须位于行棋方底线的 c 线或 g 线上。"
