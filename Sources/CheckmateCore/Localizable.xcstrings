    "Offline analysis is unavailable for this game. The record remains navigable; try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对局暂时无法进行离线分析。你仍可浏览棋谱，请稍后重试。"
          }
        }
      }
    },
    "Offline lesson storage is unavailable. English lessons remain available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线课程存储不可用。英语课程仍可使用。"
          }
        }
      }
    },
    "On": {
      "comment": "State of a toggle",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开"
          }
        }
      }
    },
    "On request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需"
          }
        }
      }
    },
    "Once Codex is set up, turns on Allow Codex connections each time Checkmate opens. Allow Codex connections changes only this session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置好 Codex 后，每次打开 Checkmate 时都会开启“允许 Codex 连接”。“允许 Codex 连接”的更改仅对本次会话有效。"
          }
        }
      }
    },
    "One good move: %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种好走法：%@。"
          }
        }
      }
    },
    "One of your pieces is in danger": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一枚棋子有危险"
          }
        }
      }
    },
    "One shortest route from here: %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这里出发的一条最短路线：%@。"
          }
        }
      }
    },
    "Only a finished training game can be reviewed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能复盘已结束的训练对局。"
          }
        }
      }
    },
    "Only a pawn reaching the last rank promotes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有到达另一端底线的兵才能升变。"
          }
        }
      }
    },
    "Only a pawn reaching the last rank promotes; this move takes no promotion piece.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有到达另一端底线的兵才能升变；这步棋不能指定升变棋子。"
          }
        }
      }
    },
    "Only a pawn that reaches the last rank becomes a new piece.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有到达另一端底线的兵才能升变为其他棋子。"
          }
        }
      }
    },
    "Only a training game can be reviewed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能复盘训练对局。"
          }
        }
      }
    },
    "Only move": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一走法"
          }
        }
      }
    },
    "Only standard chess is supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持标准国际象棋。"
          }
        }
      }
    },
    "Open": {
      "comment": "Verb: open the item",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        }
      }
    },
    "Open %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 %@"
          }
        }
      }
    },
    "Open Connection Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开连接设置"
          }
        }
      }
    },
    "Open Local Network Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开本地网络设置"
          }
        }
      }
    },
    "Open Microphone Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开麦克风设置"
          }
        }
      }
    },
    "Open PGN…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 PGN…"
          }
        }
      }
    },
    "Open Recent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开最近使用"
          }
        }
      }
    },
    "Open Voice Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开语音设置"
          }
        }
      }
    },
    "Open a finished or unfinished game, including its recorded moves and variations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开已结束或未结束的对局，包括记录的走法和变化。"
          }
        }
      }
    },
    "Open a lesson from the sidebar. Lessons play with narration; use Lesson ▸ Play (⌥⌘P), Previous Step (⌘[) and Next Step (⌘]) to move through them. Quick puzzles and practice activities are in the sidebar too.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从侧边栏打开课程。课程播放时配有语音解说；使用“课程 ▸ 播放”(⌥⌘P)、“上一步”(⌘[) 和“下一步”(⌘]) 浏览课程。侧边栏中也有快速习题和练习活动。"
          }
        }
      }
    },
    "Opening a game for review analyzes it with Stockfish. Moves already analyzed are not searched again. The bar beside the board shows the evaluation, and the arrow shows the engine's choice. Neither is shown during a network game, and nothing is analyzed then.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开对局进行复盘时，会使用 Stockfish 分析。已分析过的走法不会重复搜索。棋盘旁的评估条显示局面评估，箭头显示引擎推荐的走法。网络对局期间不会显示这两项，也不会进行分析。"
          }
        }
      }
    },
    "Opening microphone…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在开启麦克风…"
          }
        }
      }
    },
    "Opens a page of free PGN downloads in your browser.": {
      "localizations": {
        "zh-Hans": {
