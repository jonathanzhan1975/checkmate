        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上没有棋子。"
          }
        }
      }
    },
    "These are square-control relationships. Kings cannot be captured or recaptured.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些表示对格子的控制关系。王不能被吃，也不能被回吃。"
