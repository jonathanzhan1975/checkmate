    },
    "Your turn · White": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你了 · 白方"
          }
        }
      }
    },
    "Your turn — listening": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你了 — 正在聆听"
          }
        }
      }
    },
    "Your turn. Move a White piece on the board.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你了。在棋盘上移动一枚白方棋子。"
          }
        }
      }
    },
    "Your turn: make your move on the board, or continue to the next lesson.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮到你了：在棋盘上走棋，或继续下一课。"
          }
        }
      }
    },
    "Your turn: make your move on the board.": {
      "localizations": {
