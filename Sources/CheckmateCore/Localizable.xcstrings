    "The coach could not finish that explanation. Ask again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练未能完成讲解。请重新提问。"
          }
        }
      }
    },
    "The coach took too long to answer. Try again.": {
      "localizations": {
