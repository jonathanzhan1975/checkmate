          }
        }
      }
    },
    "a material task needs at least one move that meets its goal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子力任务至少需要一个能达成目标的走法"
          }
        }
      }
    },
    "a mixed case lists its skills and primary skill": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "混合案例须列出所需技能和主要技能"
          }
        }
      }
    },
    "a moment is one decision with some moves right and some wrong": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键时刻须为一次决策，且同时存在正确和错误的走法"
          }
        }
      }
    },
    "a move objective ships its teaching graph": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走棋目标须附带教学图"
          }
        }
      }
    },
    "a move that meets the threat": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能化解威胁的走法"
          }
        }
      }
    },
    "a movement drill needs its piece and a move budget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走法练习须指定棋子和步数上限"
          }
        }
      }
    },
    "a new exercise lists its variants": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新练习须列出其变体"
          }
        }
      }
    },
    "a pawn race starts with exactly one learner pawn": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兵的竞速起始时，学习者一方须恰好有一个兵"
          }
        }
      }
    },
    "a position game keeps only piece types the learner has": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局面对局只能保留学习者拥有的棋子类型"
          }
        }
      }
    },
    "a position game names its goal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局面对局须指定目标"
          }
        }
      }
    },
    "a position game's goal belongs to a position game": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局面对局的目标须属于局面对局"
          }
        }
      }
    },
    "a position game's goal is checkmate or promoteAndHold, with threshold 0 and no target, draw rule or horizon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局面对局的目标须为 checkmate 或 promoteAndHold，阈值为 0，且不得包含目标棋子、和棋规则或搜索深度"
          }
        }
      }
    },
    "a recognition diagram needs pieces and a marked square, and no drill": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别图示须包含棋子和标记格，且不得包含走法练习"
          }
        }
      }
    },
    "a recognition question names the asked color, and only it does": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别题须指定所问的执棋颜色，且仅此类题目可指定"
          }
        }
      }
    },
    "a scenario is either curated (reviewed) or generated, not both": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "情境须为人工编选（已审核）或自动生成，两者不可兼有"
          }
        }
      }
    },
    "a searched objective needs a goal and an odd horizon of one to five plies": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索型任务须指定目标，搜索深度须为 1 至 5 个半回合中的奇数"
          }
        }
      }
    },
    "a survival goal names its target and belongs to Save Your Piece": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保子目标须指定目标棋子，并属于“保住你的棋子”"
          }
        }
      }
    },
    "accepted evasions differ from the oracle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认可的应将走法与标准判定不一致"
          }
        }
      }
    },
    "accepted mates differ from the oracle: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认可的将死走法与标准判定不一致：%@"
          }
        }
      }
    },
    "an Increment B scenario names its evaluator": {
      "comment": "Why a training scenario is invalid",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Increment B 情境须指定评估器"
          }
        }
      }
    },
    "an attacked square cannot hold the asked side's own piece": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受攻击的格子上不能有被问一方自己的棋子"
          }
        }
      }
    },
    "an ending starts from its position with the halfmove clock at 0": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "残局须从指定局面开始，半回合计数器设为 0"
          }
        }
      }
    },
    "an exchange question states its line and offers the three results": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兑子问题须给出走棋变化，并提供三种结果"
          }
        }
      }
    },
    "an exchange question states its line, and only it does": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兑子问题须给出走棋变化，且仅此类问题可给出"
          }
        }
      }
    },
    "answering a threat": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应对威胁"
          }
        }
      }
    },
    "at least one move must save the piece": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少须有一个走法能保住棋子"
          }
        }
      }
    },
    "attack and protection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "攻击与保护"
          }
        }
      }
    },
    "attacked by %@ %@": {
      "comment": "A square's description: the piece attacking it, then whether that is restricted",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "attacked by %1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受到 %1$@ %2$@ 的攻击"
          }
        }
      }
    },
    "attacked by %lld, defended by %lld": {
      "comment": "A square's description: how many pieces attack and defend it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "attacked by %1$lld, defended by %2$lld"
          }
        },
