          "stringUnit": {
            "state": "translated",
            "value": "轮到你了：在棋盘上走棋。"
          }
        }
      }
    },
    "Zoom": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放"
          }
        }
      }
    },
    "a castling question names the king's square and offers every reason": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "王车易位问题须指明王所在的格子，并提供所有原因"
          }
        }
      }
    },
    "a choice needs at least two distinct options": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择题至少需要两个不同选项"
          }
        }
      }
    },
    "a diagnosis offers every concern and names the genuine ones": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局面诊断须列出所有潜在问题，并指出实际存在的问题"
          }
        }
      }
    },
    "a diagnosis position has the learner out of check": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断局面中，学习者一方不得被将军"
          }
        }
      }
    },
    "a free piece is won by a capture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过吃子赢得可白吃的棋子"
          }
        }
      }
    },
    "a gain goal has a positive threshold and no target": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获利目标的阈值须为正数，且不得指定目标棋子"
          }
        }
      }
    },
    "a game start is a position only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对局起始状态只能包含局面"
          }
        }
      }
    },
    "a guided game belongs to the guided-game workflow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导对局须属于引导对局流程"
          }
        }
      }
    },
    "a guided game starts quietly, not in check": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导对局须从平静且未被将军的局面开始"
          }
        }
      }
    },
    "a hold goal has a threshold of zero or less and no target": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守住局面的目标阈值须小于或等于零，且不得指定目标棋子"
          }
        }
      }
    },
    "a legacy game names exactly one mini-game": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版对局须指定且仅指定一个迷你对局"
          }
        }
      }
    },
    "a legacy game's identifier is its mini-game's": {
      "localizations": {
        "zh-Hans": {
