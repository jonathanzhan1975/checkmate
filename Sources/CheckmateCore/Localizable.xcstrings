    "Your ChatGPT account cannot use live voice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 ChatGPT 账户无法使用实时语音。"
          }
        }
      }
    },
    "Your Codex sign-in has expired and could not be renewed. Open Codex and sign in again with your ChatGPT account, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Codex 登录已过期，且无法续期。请打开 Codex，使用你的 ChatGPT 账户重新登录，然后重试。"
          }
        }
      }
    },
    "Your Codex sign-in has expired and could not be renewed. Open Codex and sign in again, then translate again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Codex 登录已过期，且无法续期。请打开 Codex 重新登录，然后重新翻译。"
          }
        }
      }
    },
    "Your Codex sign-in was not accepted, which usually means it is too old. Open Codex and sign in again with your ChatGPT account, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Codex 登录未被接受，通常是因为登录已失效。请打开 Codex，使用你的 ChatGPT 账户重新登录，然后重试。"
          }
        }
      }
    },
    "Your Mac could not play the coach's voice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 无法播放教练的语音。"
          }
        }
      }
    },
    "Your account has used live voice a lot recently, so it is paused for now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户近期使用实时语音较多，该功能已暂时停用。"
          }
        }
      }
    },
    "Your attempt is paused.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次作答已暂停。"
          }
