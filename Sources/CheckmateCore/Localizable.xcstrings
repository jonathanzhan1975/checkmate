    "%@ on %@": {
      "comment": "A piece by side and kind, then its square, such as White knight on f3",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（位于%2$@）"
          }
        }
      }
    },
    "%@ on %@ attacks %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@ attacks %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（位于%2$@）攻击%3$@。"
          }
        }
      }
    },
    "%@ on %@ belongs to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@ belongs to %3$@."
          }
        },
