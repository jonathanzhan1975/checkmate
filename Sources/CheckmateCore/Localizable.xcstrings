          "stringUnit": {
            "state": "translated",
            "value": "%1$@（位于%2$@）可以吃掉%3$@。"
          }
        }
      }
    },
    "%@ on %@ cannot land on %@, where a piece of its own side stands.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@ cannot land on %3$@, where a piece of its own side stands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（位于%2$@）不能走到%3$@，那里有己方棋子。"
          }
        }
      }
    },
    "%@ on %@ covers %@. Check pins and legal replies before treating coverage as a capture.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ on %2$@ covers %3$@. Check pins and legal replies before treating coverage as a capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（位于%2$@）控制着%3$@。判断能否吃子前，请先检查牵制和合法应对。"
          }
        }
      }
    },
    "%@ on %@ defends %@ on %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
