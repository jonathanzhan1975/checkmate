      }
    },
    "At %@, both king and rook change squares. Inspect the king's safety afterward.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走出%@时，王和车都会换格。请检查易位后王是否安全。"
          }
        }
      }
    },
    "At %@: %lld won, %lld drawn, %lld lost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "At %1$@: %2$lld won, %3$lld drawn, %4$lld lost"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %1$@：%2$lld 胜，%3$lld 和，%4$lld 负"
          }
        }
      }
    },
    "At move %lld you had a checkmate, and played %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "At move %1$lld you had a checkmate, and played %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 回合时，你有将死的机会，却走了 %2$@。"
          }
        }
      }
    },
    "At move %lld, after %@, your opponent could checkmate at once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "At move %1$lld, after %2$@, your opponent could checkmate at once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 回合，走了 %2$@ 后，对手可以立即将死。"
