      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找和加入网络对局需要本地网络访问权限。请在“系统设置 › 隐私与安全性 › 本地网络”中开启 Checkmate；开启后，等待中的对局会自动继续。"
          }
        }
